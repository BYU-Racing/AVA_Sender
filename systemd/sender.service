[Unit]
Description=AVA CAN telemetry sender
Wants=network-online.target
After=network-online.target

[Service]
Type=simple
User=pi
WorkingDirectory=/opt/AVA_Sender
EnvironmentEnvironmentFile=/opt/AVA_Sender/.env
ExecStart=/opt/AVA_Sender/run.sh

Restart=always
RestartSec=2

[Install]
WantedBy=multi-user.target